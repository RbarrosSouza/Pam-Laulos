      "parameters": {
        "content": "OPERACIONAL — salvo desativado. Reutiliza as conexões existentes. Definir o corte e liberar após a migração definitiva e substituição do importador legado. Sem journal ou autorização temporária. Não enviar novamente uma mensagem de grupo com retorno incerto.",
        "height": 220,
        "width": 580
      }
    },
    {
      "id": "b7cb2327-bd51-56ea-8261-f2c861d8f69d",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -480,
        0
      ],
      "parameters": {
