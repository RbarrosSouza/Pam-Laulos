      "id": "a1f50d00-0e6b-511e-abfe-eeaf7596e75a",
      "name": "Tarefa disponível",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const state=$('Orçamento disponível').item.json;\nconst task=$json.tasks[0];\nif(!task||task.destination!==\"nexus\")throw new Error('pipeline_task_destination_invalid');\nconst cfg=$('Configuração').first().json;\nconst expected='chatwoot:'+cfg.accountId+':'+cfg.inboxId+':'+cfg.conversationId+':'+cfg.groupJid;\nreturn [{json:{...task,drain:state,destinationVerified:task.configured_destination===expected}}];"
      }
