    {
      "id": "365717c5-2985-5829-a4b9-930121ef708e",
      "name": "Preparar próxima tarefa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        800
      ],
      "parameters": {
        "jsCode": "function pipelineDrainAvailable(state, now = Date.now()) {\n  if (!state || !Number.isFinite(state.startedAt) || !Number.isInteger(state.count) || state.count < 0 ||\n      state.maxTasks !== 4 || state.maxSeconds !== 180 || typeof state.workerToken !== 'string' || !state.workerToken ||\n      !Number.isFinite(now) || now < state.startedAt) throw new Error('pipeline_drain_state_invalid');\n  return state.count < state.maxTasks && now - state.startedAt < state.maxSeconds * 1000;\n}\nfunction advancePipelineDrain(state, receipt, taskId) {\n  pipelineDrainAvailable(state);\n  if (!taskId || receipt?.task?.id !== taskId || !['completed','sent','submitted','uncertain','failed'].includes(receipt.task.status))\n    throw new Error('pipeline_task_outcome_unproven');\n  return {...state,count:state.count + 1};\n}\nconst task=$('Tarefa disponível').item.json;return [{json:advancePipelineDrain(task.drain,$json,task.id)}];"
      }
    },
