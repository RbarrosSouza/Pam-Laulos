    {
      "id": "3d32e541-a1c3-56ee-a522-6fd8243de268",
      "name": "Iniciar rodada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        800
      ],
      "parameters": {
        "jsCode": "function startPipelineDrain(stage, worker, lease, now = Date.now()) {\n  if (!['processing','group','nexus','rename','reconcile'].includes(stage) || typeof worker !== 'string' || !worker ||\n      lease?.claimed !== true || typeof lease.lease_token !== 'string' || !lease.lease_token || !Number.isFinite(now) ||\n      !Number.isFinite(Date.parse(lease.lease_until)) || Date.parse(lease.lease_until) < now + 600000)\n    throw new Error('pipeline_worker_lease_unproven');\n  return {stage,worker,workerToken:lease.lease_token,startedAt:now,count:0,maxTasks:4,maxSeconds:180};\n}\nreturn [{json:startPipelineDrain($('Configuração').first().json.pipelineStage,$('Configuração').first().json.worker,$json)}];"
      }
    },
    {
      "id": "9912a6b5-993b-5194-a789-7c9c6bef1c99",
      "name": "Orçamento disponível",
