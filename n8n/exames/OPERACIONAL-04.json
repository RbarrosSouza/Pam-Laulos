            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "pipeline-condition",
              "leftValue": "={{ $json.count < 4 && Date.now() - $json.startedAt < 180000 }}",
              "rightValue": true,
              "operator": {
