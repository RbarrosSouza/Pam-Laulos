      "name": "Validar temporário e pasta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        -520
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (!bytes.length || bytes.length > $('Configuração').first().json.maxBytes) throw new Error('PDF vazio ou fora do limite de bytes.');\nif (!bytes.subarray(0, 1024).includes(Buffer.from('%PDF-'))) throw new Error('Assinatura PDF ausente.');\nconst sha256 = crypto.createHash('sha256').update(bytes).digest('hex');\nconst task=$('Uma reserva Drive por vez').item.json;\nconst folderId=$('Configuração').first().json.driveFolders[task.document.received_at.slice(0,7)];\nif(!folderId)throw new Error('Pasta Drive do temporário ainda não configurada.');\nreturn [{json:{task,folderId,sha256,sizeBytes:bytes.length},binary:$input.first().binary}];\n"
      }
