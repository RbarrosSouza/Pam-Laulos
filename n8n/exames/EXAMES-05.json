    {
      "id": "2a50842a-0af0-52bc-badd-8b375d657696",
      "name": "Validar objeto pendente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -160
      ],
      "parameters": {
        "jsCode": "const task=$('Uma reserva Drive por vez').item.json;\nif(!$input.first().binary?.data)return [{json:{task,valid:false}}];\nconst bytes=await this.helpers.getBinaryDataBuffer(0,'data');\nconst sha256=require('crypto').createHash('sha256').update(bytes).digest('hex');\nreturn [{json:{task,valid:sha256===task.document.sha256&&bytes.length===Number(task.document.size_bytes),sha256,size_bytes:bytes.length}}];\n"
      }
    },
