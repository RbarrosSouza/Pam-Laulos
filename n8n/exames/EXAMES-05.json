    {
      "id": "2ce3d266-2b05-55c3-9834-c0595e5d958a",
      "name": "Pendências de grupo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração').first().json;const tasks=$('Reconciliar leases e pendências').first().json.group_tasks||[];if(!tasks.length)return [];if(!cfg.chatwootBaseUrl||!cfg.accountId||!cfg.inboxId||!cfg.conversationId||!cfg.groupJid.endsWith('@g.us'))throw new Error('Há grupo a reconciliar, mas destino não configurado.');const expected='chatwoot:'+cfg.accountId+':'+cfg.inboxId+':'+cfg.conversationId+':'+cfg.groupJid;for(const task of tasks){if((task.configured_destination||task.destination_key)!==expected)throw new Error('Reconciliação exige configuração do destino original da tarefa.');}return tasks.map(t=>({json:t}));"
      }
    },
