    {
      "id": "772a856a-a171-5a0f-be3e-4b81607179bf",
      "name": "Chatwoot - consultar mensagens",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.chatwootBaseUrl+'/api/v1/accounts/'+$('Configuração').first().json.accountId+'/conversations/'+$('Configuração').first().json.conversationId+'/messages' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "before",
                    "value": "={{ Math.min(...($response.body.payload||[]).map(m=>Number(m.id))) }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !($response.body.payload||[]).length || ($response.body.payload||[]).some(m=>new Date(Number(m.created_at)*1000).getTime()<Date.parse($json.created_at||$json.document.received_at)-86400000) }}",
              "requestInterval": 250,
              "limitPagesFetched": false
            }
          }
        }
      }
    },
    {
      "id": "f2fc2b1d-6136-54d2-83da-573f41e95802",
      "name": "Reconciliar status e correlação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        240
      ],
      "parameters": {
        "jsCode": "const task=$('Uma mensagem por vez').item.json;\nconst list=[];for(const page of $input.all()){const value=page.json;list.push(...(value.payload||value.messages||[]));}\nconst correlation='[EXAM:'+task.document.id+':DELIVERY:'+task.id+']';\nconst found=list.filter(m=>task.external_id?String(m.id)===String(task.external_id):String(m.content||'').includes(correlation));\nif(found.length!==1)return [{json:{task,outcome:{status:'uncertain',error:found.length?'Correlação ambígua; revisão necessária':'Não localizado na página consultada; revisão necessária',external_status:'reconciliation_inconclusive'}}}];\nconst m=found[0];\nconst providerSent=$('Configuração').first().json.providerConfirmationStatuses.includes(String(m.status));\nreturn [{json:{task,outcome:{status:providerSent?'sent':(m.status==='failed'?'uncertain':'submitted'),external_id:String(m.id),external_status:String(m.status||'api_created'),correlation}}}];\n"
      }
    },
