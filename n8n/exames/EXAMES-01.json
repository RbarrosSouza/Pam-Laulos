    {
      "id": "63e1c157-cf1c-56fb-a613-5891a8a9d5e0",
      "name": "Conferir integridade do original",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5760,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (!bytes.length || bytes.length > $('Configuração').first().json.maxBytes) throw new Error('PDF vazio ou fora do limite de bytes.');\nif (!bytes.subarray(0, 1024).includes(Buffer.from('%PDF-'))) throw new Error('Assinatura PDF ausente.');\nconst sha256 = crypto.createHash('sha256').update(bytes).digest('hex');\nconst src=$('Validar bytes e SHA-256').item.json;\nif(sha256!==src.sha256||bytes.length!==src.sizeBytes)throw new Error('Conflito de integridade no Drive. Não sobrescrever arquivo existente.');\nreturn [{json:{stage:$('Reservar ID e upload Drive').item.json,source:src}}];\n"
      }
    },
