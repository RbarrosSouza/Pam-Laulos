    {
      "id": "89bdec30-2578-5126-aabd-7b2b878b7de5",
      "name": "Leia antes de configurar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -250,
        -300
      ],
      "parameters": {
        "content": "DESATIVADO. Coleta paginada de todas as pastas configuradas, IDs imutáveis e todos os anexos. ID Drive reservado antes do upload; readback SHA-256. Nenhum segredo no export. Requer crypto no Code e credenciais selecionadas. Não roda o importador legado.",
        "height": 220,
        "width": 580
      }
    },
    {
      "id": "69d744f7-2dca-520e-ba69-7a8885609a98",
      "name": "A cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
