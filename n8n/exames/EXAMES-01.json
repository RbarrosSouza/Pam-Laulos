    {
      "id": "f358b76e-fe93-5c12-9a09-0b7f4c5253ad",
      "name": "Validar bytes e SHA-256",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (!bytes.length || bytes.length > $('Configuração').first().json.maxBytes) throw new Error('PDF vazio ou fora do limite de bytes.');\nif (!bytes.subarray(0, 1024).includes(Buffer.from('%PDF-'))) throw new Error('Assinatura PDF ausente.');\nconst sha256 = crypto.createHash('sha256').update(bytes).digest('hex');\nconst source=$('Decidir recebimento').item.json;\nconst period=source.message.receivedDateTime.slice(0,7);\nconst folderId=$('Configuração').first().json.driveFolders[period];\nif(!folderId)throw new Error('Pasta Drive não configurada para '+period+'. Origem preservada para retomada.');\nreturn [{json:{...source,sha256,sizeBytes:bytes.length,folderId},binary:$input.first().binary}];\n"
      },
      "onError": "continueRegularOutput"
    },
