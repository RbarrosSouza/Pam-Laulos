    {
      "id": "f78773d4-1667-51ce-8942-efecae14af28",
      "name": "Mensagens elegíveis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração').first().json;\nconst messages=[];const seen=new Set();\nfunction collect(v){if(Array.isArray(v)){for(const x of v)collect(x);}else if(v&&Array.isArray(v.value)){for(const m of v.value){if(!seen.has(m.id)){seen.add(m.id);messages.push(m);}}}}\nfor(const item of $input.all())collect(item.json);\nconst out=[];\nfor(const m of messages){\n const sender=(m.from?.emailAddress?.address||'').toLowerCase();\n const trusted=cfg.allowedSenders.includes(sender);\n const hint=cfg.examSubjectHints.some(h=>(m.subject||'').toLowerCase().includes(h));\n if(!trusted&&!hint)continue;\n out.push({json:{...m,sender,unknownSender:!trusted}});\n}\nreturn out.length?out:[{json:{emptySweep:true}}];\n"
      }
    },
