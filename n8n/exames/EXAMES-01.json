    {
      "id": "09b5f831-5ad8-54c5-b56e-3a935395289c",
      "name": "Enumerar anexos e ausência",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const message=$('Mensagem disponível').item.json;const list=[];\nfunction collect(v){if(Array.isArray(v)){for(const x of v)collect(x);}else if(v?.value)list.push(...v.value);}\nfor(const i of $input.all())collect(i.json);\nconst candidates=list.filter(a=>!a.isInline && !(String(a.contentType||'').startsWith('image/')&&/logo|assinatura|signature|image\\d|banner/i.test(a.name||'')));\nif(!candidates.length)return [{json:{message,missing:true,attachment:{id:'missing-pdf',name:'PDF ausente',contentType:null}}}];\nreturn candidates.map(a=>({json:{message,attachment:a,missing:!(a.contentType==='application/pdf'||/\\.pdf$/i.test(a.name||''))||a['@odata.type']==='#microsoft.graph.referenceAttachment'||a['@odata.type']==='#microsoft.graph.itemAttachment'}}));\n"
      }
    },
