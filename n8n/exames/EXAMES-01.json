      }
    },
    {
      "id": "9053245a-f5a6-56d8-903b-4f11c7a1658a",
      "name": "Confirmar varredura concluída",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -360
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração').first().json;\nconst state=$getWorkflowStaticData('global');\nconst failed=Boolean(state.failedSweeps?.[cfg.sweepId]);\nif(!failed)state.watermark=cfg.sweepEnd;\nif(state.failedSweeps)delete state.failedSweeps[cfg.sweepId];\nreturn [{json:{complete:!failed,sweepEnd:cfg.sweepEnd,watermarkAdvanced:!failed}}];\n"
      }
    },
