    {
      "id": "9c126060-f046-5573-9f64-d9c5c824d16c",
      "name": "Validar PDF WhatsApp e pasta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst bytes = await this.helpers.getBinaryDataBuffer(0, 'data');\nif (!bytes.length || bytes.length > $('Configuração').first().json.maxBytes) throw new Error('PDF vazio ou fora do limite de bytes.');\nif (!bytes.subarray(0, 1024).includes(Buffer.from('%PDF-'))) throw new Error('Assinatura PDF ausente.');\nconst sha256 = crypto.createHash('sha256').update(bytes).digest('hex');\nconst origin=$('Um PDF WhatsApp por vez').item.json;\nconst folderId=$('Configuração').first().json.driveFolders[origin.receivedAt.slice(0,7)];\nif(!folderId)throw new Error('Pasta Drive não configurada para o recebimento.');\nreturn [{json:{origin,documentId:$('Reservar origem WhatsApp').item.json.document_id,sha256,sizeBytes:bytes.length,folderId},binary:$input.first().binary}];\n"
      },
      "onError": "continueRegularOutput"
    },
