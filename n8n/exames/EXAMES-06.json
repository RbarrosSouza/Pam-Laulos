{
  "name": "EXAMES-06 — Receber WhatsApp",
  "active": false,
  "nodes": [
    {
      "id": "89bdec30-2578-5126-aabd-7b2b878b7de5",
      "name": "Leia antes de configurar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -250,
        -300
      ],
      "parameters": {
        "content": "ETAPA FINAL — DESATIVADO. Webhook exige credencial Header Auth separada; configurar assinatura/proxy antes do piloto. Somente message_created INCOMING, caixa/remetente allowlist, PDF. Exclui grupo destino, privados, correlação EXAM e URLs fora da allowlist. Mesmo hash e reserva Drive do e-mail.",
        "height": 220,
        "width": 580
      }
    },
    {
      "id": "b95ea5eb-dcd6-5b57-8cfb-473e7ec9ffa2",
      "name": "Webhook Chatwoot autenticado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "pamvet-exames-chatwoot-v1",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "a16618ce-6e97-5d13-95fc-23c6340ff479",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "jsCode": "// Configure IDs only. Select credentials in HTTP nodes; never paste secrets here.\nconst cfg = {\n enabled: false,\n serviceUrl: '', // https://PROJECT.supabase.co/functions/v1/exam-document-service\n driveFolders: {}, // {'2026-10':'VERIFIED_MONTH_FOLDER_ID'}; year/month folders under the exam root\n notificationCutoff: '', // ISO timestamp agreed for the pilot\n maxBytes: 20 * 1024 * 1024,\n worker: 'n8n-exames',\n};\nif (!cfg.enabled) throw new Error('EXAMES pausado: habilite somente após configurar e validar o piloto.');\nif (!/^https:\\/\\/[^/]+\\/functions\\/v1\\/exam-document-service$/.test(cfg.serviceUrl)) throw new Error('serviceUrl inválida.');\ncfg.worker += ':' + $execution.id;\nObject.assign(cfg,{accountId:null,inboxId:null,allowedConversationIds:[],allowedSenderIds:[],destinationConversationId:null,allowedDownloadOrigins:[],sourceChannel:'whatsapp'});\nif(!cfg.accountId||!cfg.inboxId||(!cfg.allowedConversationIds.length&&!cfg.allowedSenderIds.length)||!cfg.destinationConversationId||!cfg.allowedDownloadOrigins.length)throw new Error('Allowlist WhatsApp incompleta.');\nreturn [{json:cfg}];\n"
      }
    },
    {
      "id": "6de0e0c8-e1f1-5560-9046-4b8b40a96001",
      "name": "Validar evento e todos os PDFs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuração').first().json;const body=$('Webhook Chatwoot autenticado').first().json.body;\nif(!body||body.event!=='message_created'||body.private===true||!(body.message_type==='incoming'||body.message_type===0))return [];\nconst conversationId=Number(body.conversation?.id||body.conversation_id);\nconst inboxId=Number(body.inbox?.id||body.inbox_id||body.conversation?.inbox_id);\nconst accountId=Number(body.account?.id||body.account_id);\nconst senderId=Number(body.sender?.id);\nif(accountId!==Number(cfg.accountId)||inboxId!==Number(cfg.inboxId)||conversationId===Number(cfg.destinationConversationId)||(!cfg.allowedConversationIds.map(Number).includes(conversationId)&&!cfg.allowedSenderIds.map(Number).includes(senderId))||String(body.content||'').includes('[EXAM:'))return [];\nif(!body.id)throw new Error('Mensagem sem ID de origem.');\nconst attachments=(body.attachments||[]).filter(a=>a.file_type==='file'&&(!a.content_type||a.content_type==='application/pdf'||/\\.pdf$/i.test(a.file_name||'')));\nif(!attachments.length)return [{json:{messageId:String(body.id),attachmentId:'missing-pdf',originalName:'PDF ausente',receivedAt:(typeof body.created_at==='number'?new Date(body.created_at*1000).toISOString():body.created_at)||new Date().toISOString(),conversationId,senderId,missing:true}}];\nreturn attachments.map(a=>{\n const url=new URL(a.data_url);if(!cfg.allowedDownloadOrigins.includes(url.origin))throw new Error('Host de anexo não permitido.');\n if(!a.id)throw new Error('Anexo sem ID de origem.');\n return {json:{messageId:String(body.id),attachmentId:String(a.id),originalName:a.file_name||('exame-'+a.id+'.pdf'),downloadUrl:url.toString(),receivedAt:(typeof body.created_at==='number'?new Date(body.created_at*1000).toISOString():body.created_at)||new Date().toISOString(),conversationId,senderId}};\n});\n"
      }
    },
